{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist",
    "rootDir": "./",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "core/**/*.ts",
    "resources/**/*.ts",
    "services/**/*.ts",
    "runtime/**/*.ts",
    "monitoring/**/*.ts",
    "commands/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "tests"]
}
