{
  "name": "@web-auto/camo",
  "version": "0.4.2",
  "description": "Camoufox Browser CLI - Cross-platform browser automation",
  "type": "module",
  "bin": {
    "camo": "bin/camo.mjs",
    "camo-bash": "bin/camo"
  },
  "files": [
    "bin/",
    "v2/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:file-size": "node scripts/check-file-size.mjs",
    "test": "CAMO_PKG_ROOT=$PWD node --test \"v2/tests/unit/**/*.test.mjs\" && CAMO_PKG_ROOT=$PWD node --test \"v2/tests/smoke/**/*.test.mjs\"",
    "test:v2": "CAMO_PKG_ROOT=$PWD node --test \"v2/tests/unit/**/*.test.mjs\"",
    "test:smoke": "CAMO_PKG_ROOT=$PWD node --test \"v2/tests/smoke/**/*.test.mjs\"",
    "test:e2e": "node --test 'v2/tests/e2e/**/*.test.mjs'",
    "test:all": "node --test 'v2/tests/unit/**/*.test.mjs' && node --test 'v2/tests/smoke/**/*.test.mjs' && node --test 'v2/tests/integration/**/*.test.mjs' && node --test 'v2/tests/e2e/**/*.test.mjs'",
    "gates": "cd v2 && node gates/run-all.mjs --strict",
    "version:bump": "node scripts/bump-version.mjs",
    "install:global": "npm run build && npm install -g .",
    "uninstall:global": "npm uninstall -g @web-auto/camo",
    "build:global": "npm run build && npm test && npm install -g .",
    "postinstall": "node scripts/postinstall-camoufox.mjs"
  },
  "keywords": [
    "browser",
    "automation",
    "camoufox",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "playwright-core": "1.60.0"
    }
  },
  "devDependencies": {
    "c8": "^10.1.3"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "camoufox": "0.1.19",
    "jsqr": "^1.4.0",
    "playwright-core": "1.60.0",
    "pngjs": "^7.0.0",
    "proper-lockfile": "^4.1.2",
    "ws": "^8.19.0"
  }
}
