{
  "$id": "camo.v2.modules",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schema_version", "modules"],
  "properties": {
    "schema_version": {"type": "string"},
    "status":         {"enum": ["design", "active", "deprecated"]},
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "layer", "owned_paths", "status"],
        "properties": {
          "id":          {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"},
          "layer":       {"type": "string", "pattern": "^L[0-9]_\\w+$"},
          "owned_paths": {"type": "array", "items": {"type": "string", "pattern": "^v2/.+"},
                          "minItems": 1},
          "status":      {"enum": ["design", "active", "deprecated"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
