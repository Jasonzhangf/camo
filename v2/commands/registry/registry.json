            "doc": "profile id"
          },
          "selector": {
            "type": "string",
            "min_len": 1,
            "required": false,
            "doc": "CSS selector for the input element"
          },
          "delay": {
            "type": "integer",
            "min": 0,
            "max": 5000,
            "required": false,
            "doc": "ms between keystrokes"
          }
        },
        "positional": [
