{
  "name": "@web-auto/camo",
  "version": "0.4.8",
  "description": "Camoufox Browser CLI - Cross-platform browser automation",
  "type": "module",
  "bin": {
    "camo": "bin/camo.mjs",
    "camo-bash": "bin/camo"
  },
  "files": [
    "bin/",
    "v2/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:file-size": "node scripts/check-file-size.mjs",
    "test": "node scripts/run-tests.mjs default",
    "test:v2": "node scripts/run-tests.mjs unit",
    "test:smoke": "node scripts/run-tests.mjs smoke",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:e2e": "node scripts/run-tests.mjs e2e",
    "test:all": "node scripts/run-tests.mjs all",
    "gates": "cd v2 && node gates/run-all.mjs --strict",
    "version:bump": "node scripts/bump-version.mjs",
    "install:global": "npm run build && npm install -g .",
    "uninstall:global": "npm uninstall -g @web-auto/camo",
    "build:global": "npm run build && npm test && npm install -g .",
    "postinstall": "node scripts/postinstall-camoufox.mjs"
  },
  "keywords": [
    "browser",
    "automation",
    "camoufox",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "playwright-core": "1.60.0"
    }
  },
  "devDependencies": {
    "c8": "^10.1.3"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "adm-zip": "^0.5.16",
    "camoufox": "0.1.19",
    "jsqr": "^1.4.0",
    "playwright-core": "1.60.0",
    "pngjs": "^7.0.0",
    "proper-lockfile": "^4.1.2",
    "ws": "^8.19.0"
  }
}
