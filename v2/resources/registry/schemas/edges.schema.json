{
  "$id": "camo.v2.edges",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schema_version", "edges", "forbidden_edges"],
  "properties": {
    "schema_version":              {"type": "string"},
    "status":                      {"enum": ["design", "active", "deprecated"]},
    "reverse_dependency_rule":     {"type": "string"},
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "kind", "reason"],
        "properties": {
          "from":   {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"},
          "to":     {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"},
          "kind":   {"enum": ["call", "load", "registry"]},
          "reason": {"type": "string", "maxLength": 200}
        },
        "additionalProperties": false
      }
    },
    "forbidden_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "reason"],
        "properties": {
          "from":   {"type": "string"},
          "to":     {"type": "string"},
          "reason": {"type": "string", "maxLength": 200}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
