{
  "$schema": "./schemas/resources.schema.json",
  "schema_version": "1.0.0",
  "status": "active",
  "layers": [
    {
      "id": "L0_protocol",
      "purpose": "wire formats, version envelopes, middleware",
      "depends_on": []
    },
    {
      "id": "L1_contract",
      "purpose": "per-resource builder/parser, owns the type lock",
      "depends_on": [
        "L0_protocol"
      ]
    },
    {
      "id": "L2_service",
      "purpose": "single business-truth owner per resource",
      "depends_on": [
        "L1_contract"
      ]
    },
    {
      "id": "L3_transport",
      "purpose": "servers and clients over ws/http/uds",
      "depends_on": [
        "L2_service"
      ]
    },
    {
      "id": "L4_command",
      "purpose": "command orchestration, one handler per cmd id",
      "depends_on": [
        "L3_transport"
      ]
    },
    {
      "id": "L5_shell",
      "purpose": "process entry, cli dispatch, doctor",
      "depends_on": [
        "L4_command"
      ]
    }
  ],
  "resources": [
